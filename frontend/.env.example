# Frontend environment variables — copy this file to `.env` and fill in real values.
# Vite only exposes env vars prefixed with VITE_ to the client.

# Backend API base URL.
# In dev: http://localhost:8888
# In prod: the deployed backend URL, e.g. https://idurar-backend.onrender.com
VITE_BACKEND_SERVER = "http://localhost:8888"

# Base URL for files served by the backend (same as VITE_BACKEND_SERVER in most setups).
VITE_FILE_BASE_URL = "http://localhost:8888/"

# Toggle production mode optimizations.
PROD = false
