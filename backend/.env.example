# Backend environment variables — copy this file to `.env` and fill in real values.
# NEVER commit your real .env file.

# MongoDB connection string.
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
DATABASE = "mongodb://localhost:27017"

# JWT secret — generate one with:  openssl rand -hex 32
JWT_SECRET = "replace-with-openssl-rand-hex-32"

# Environment: development | production
NODE_ENV = "development"

# Resend API key (optional — used for email features). https://resend.com
# RESEND_API = "your_resend_api_key"

# OpenAI API key (optional — used for AI features if enabled).
# OPENAI_API_KEY = "your_openai_api_key"

# Public URL where backend files are served (matches the backend's PUBLIC_SERVER_FILE).
# In dev: http://localhost:8888/
# In prod: the deployed backend URL, e.g. https://idurar-backend.onrender.com
PUBLIC_SERVER_FILE = "http://localhost:8888/"

# Frontend origin for CORS (the URL where the frontend is deployed).
CLIENT_URL = "http://localhost:3000"
